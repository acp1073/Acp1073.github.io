---
import { getLocale } from "@i18n/locale";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { getCategoryTree } from "../../utils/content-utils";
import CategoryBranch from "./CategoryBranch.astro";
import WidgetLayout from "./WidgetLayout.astro";

const locale = getLocale(Astro.url.pathname);
const categories = await getCategoryTree(locale);

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

const isCollapsed = categories.length >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.categories, locale)} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    {categories.map(node => <CategoryBranch node={node} locale={locale} />)}
</WidgetLayout>
